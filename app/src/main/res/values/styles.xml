<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sabhi input fields: Material OutlinedBox, safed andar, saaf border, focus par teal -->
    <style name="BSR.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/box_stroke_selector</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="errorTextColor">@color/danger</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="startIconTint">@color/text_secondary</item>
    </style>

    <!-- v6.7.x UI polish: one visual language across every screen. -->
    <style name="BSR.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/accent_soft_stroke</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="BSR.SettingsButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">58dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">@color/accent_soft_stroke</item>
    </style>

    <style name="BSR.SectionLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="BSR.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="BSR.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="BSRAlertDialogStyle" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/BSR.DialogShape</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="BSR.DialogShape" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>
</resources>
