<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark">

  <!-- Header -->
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:background="@color/surface1" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
      <ImageButton android:id="@+id/btnOtpBack" android:layout_width="40dp" android:layout_height="40dp"
          android:src="@android:drawable/ic_menu_close_clear_cancel"
          android:contentDescription="Back"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:tint="@color/text_primary"/>
      <TextView android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:text="OTP / 2FA Manager"
          android:textSize="19sp" android:textStyle="bold"
          android:textColor="@color/text_primary" android:layout_marginStart="10dp"/>
      <TextView android:id="@+id/tvOtpCount" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:textSize="11sp"
          android:textColor="@color/accent_blue" android:background="@drawable/badge_bg"
          android:paddingHorizontal="10dp" android:paddingVertical="4dp"/>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/BSR.TextInputLayout"
        android:layout_width="match_parent" android:layout_height="58dp"
        android:hint="Search 2FA accounts..."
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="@color/text_secondary">
      <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOtpSearch"
          android:layout_width="match_parent" android:layout_height="52dp"
          android:textColor="@color/text_primary" android:inputType="text"
          android:singleLine="true" android:maxLines="1"
          android:imeOptions="actionDone" android:importantForAutofill="noExcludeDescendants"/>
    </com.google.android.material.textfield.TextInputLayout>
  </LinearLayout>

  <!-- List / empty state -->
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
      android:layout_weight="1">
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvOtp"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="6dp" android:clipToPadding="false"/>
    <TextView android:id="@+id/tvOtpEmpty" android:layout_width="match_parent"
        android:layout_height="match_parent" android:gravity="center"
        android:text="🔢&#10;&#10;Koi 2FA entry nahi&#10;Neeche &quot;2FA jodein&quot; se secret add karein"
        android:textColor="@color/text_secondary" android:textSize="15sp"
        android:visibility="gone"/>
  </FrameLayout>

  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Code par tap = copy  •  Lamba dabayein = entry edit"
      android:textSize="11sp" android:textColor="@color/text_hint"
      android:gravity="center" android:paddingTop="6dp"/>

  <Button android:id="@+id/btnOtpAdd" style="@style/BSR.Button"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_margin="12dp" android:text="＋ 2FA jodein"
      android:backgroundTint="@color/accent_blue" android:textColor="@color/white"/>
</LinearLayout>
