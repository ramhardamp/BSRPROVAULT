<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🩺  Diagnostics &amp; Self-Test"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="System info + Autofill status + safe in-memory crypto/backup round-trip tests — sab ek jagah. Aapki asli vault entries kabhi change nahi hoti."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="14dp"/>

        <!-- Top-line verdict badge -->
        <TextView
            android:id="@+id/tvDiagVerdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:background="@drawable/badge_bg"
            android:layout_marginBottom="12dp"
            android:text="Checking…"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRunDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="▶  Run Diagnostics"
            android:textAllCaps="false"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="📋  Copy Full Report"
            android:textAllCaps="false"
            android:backgroundTint="@color/surface1"
            android:textColor="@color/text_primary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearDiagLog"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="🗑️  Clear Event Log"
            android:textAllCaps="false"
            android:backgroundTint="@color/surface1"
            android:textColor="@color/text_primary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            android:text="✕  Close"
            android:textAllCaps="false"
            android:backgroundTint="@color/surface1"
            android:textColor="@color/text_primary"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface1"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">
            <TextView
                android:id="@+id/tvDiagReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="11.5sp"
                android:textColor="@color/text_primary"
                android:text="Checking…"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
